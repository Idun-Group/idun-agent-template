# Idun Platform (Manager mode)
# Set these to connect your agent to the Idun Manager instead of running standalone
# IDUN_MANAGER_HOST=http://localhost:8000
# IDUN_AGENT_API_KEY=
# Get your API key from the Agent Detail > API Integration tab in the Manager UI
# Docs: https://docs.idunplatform.com/manager/tutorial

GUARDRAILS_API_KEY="XXXXX"
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=XXXX
GOOGLE_CLOUD_LOCATION=us-central1
